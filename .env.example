# ===================================================
# SentinelMind Environment Configuration
# ===================================================

# Server Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=True

# Hindsight Vectorize Configuration (Persistent Memory)
# Get your API key and instance from https://ui.hindsight.vectorize.io (Promo: MEMHACK99)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=sentinelmind-soc-bank

# LLM Configuration (Groq or OpenAI compatible)
# Get free fast API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
